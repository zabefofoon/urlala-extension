{
	"name": "wxt-svelte-starter",
	"description": "manifest.json description",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"build:safari": "wxt build -b safari && xcrun safari-web-extension-converter .output/safari-mv2 --project-location .output --app-name urlala-extension --bundle-identifier com.urlala.extension --no-open",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"zip:safari": "wxt zip -b safari",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint src",
		"format": "prettier --write src",
		"postinstall": "wxt prepare"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.1",
		"@tsconfig/svelte": "^5.0.8",
		"@wxt-dev/module-svelte": "^2.0.4",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"tailwindcss": "^4.3.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.61.1",
		"wxt": "^0.20.26"
	},
	"dependencies": {
		"axios": "^1.18.0",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.21",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^3.6.0"
	}
}
